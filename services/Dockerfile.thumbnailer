FROM python:3.12-slim
ENV PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app
COPY services/thumbnailer/requirements.txt services/thumbnailer/requirements.lock ./
RUN --mount=type=cache,target=/root/.cache/pip pip install --require-hashes -r requirements.lock \
    && pip install --no-index --no-deps -r requirements.txt \
    && python -c 'from PIL import features; assert features.check_feature("libjpeg_turbo")'
COPY services/worker_runtime.py services/metrics.py ./
COPY --chmod=0644 services/thumbnailer/server.py services/thumbnailer/app.py services/thumbnailer/cache.py services/thumbnailer/thumbnail.py services/thumbnailer/worker.py ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python", "server.py"]
