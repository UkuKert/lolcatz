FROM golang:1.26-alpine AS source
WORKDIR /app
COPY services/go.mod services/go.sum ./
RUN go mod download
COPY services/internal ./internal
COPY services/admin ./admin
COPY services/browse ./browse
COPY services/comments ./comments
COPY services/exif ./exif
COPY services/uploader ./uploader

FROM source AS tests
CMD ["go", "test", "./..."]

FROM source AS build
ARG SERVICE
RUN --mount=type=cache,target=/root/.cache/go-build \
    test -n "$SERVICE" && CGO_ENABLED=0 go build -ldflags="-s -w" -o /app/server "./$SERVICE"

FROM alpine:3.20 AS runtime
COPY --from=build /app/server /server
EXPOSE 8080
ENTRYPOINT ["/server"]
